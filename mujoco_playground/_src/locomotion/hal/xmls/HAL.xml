<!-- HAL Model

    The state space is populated with joints in the order that they are
    defined in this file. The actuators also operate on joints.

    State-Space (name/joint/parameter):
        - rootx     slider      position (m)
        - rootz     slider      position (m)
        - rooty     hinge       angle (rad)
        - spine     hinge       angle (rad)
        - bthigh    hinge       angle (rad)
        - bshin     hinge       angle (rad)
        - fthigh    hinge       angle (rad)
        - fshin     hinge       angle (rad)
        - rootx     slider      velocity (m/s)
        - rootz     slider      velocity (m/s)
        - rooty     hinge       angular velocity (rad/s)
        - spine     hinge       angular velocity (rad/s)
        - bthigh    hinge       angular velocity (rad/s)
        - bshin     hinge       angular velocity (rad/s)
        - fthigh    hinge       angular velocity (rad/s)
        - fshin     hinge       angular velocity (rad/s)

    Actuators (name/actuator/parameter):
        - spine     hinge       torque (N m)
        - bthigh    hinge       torque (N m)
        - bshin     hinge       torque (N m)
        - fthigh    hinge       torque (N m)
        - fshin     hinge       torque (N m)

-->
<mujoco model="HAL">
    <compiler angle="radian" coordinate="local" inertiafromgeom="true" settotalmass="5"/>

    <default>
        <joint armature=".005" damping=".5"/>
        <!-- set conaffinity to 1 to enable collision between body and floor; 
             set both conaffinity and contype to 1 to enable full collision.
        -->
        <geom contype="0" conaffinity="0" condim="3" friction=".8 .02 .01"/>
        <default class="foot">
          <!--
          This specific line enables collisions for the feet only.
          The floor is contype=1, conaffinity=0 so this implies that the feet cannot
          collide with each other, but they can collide with the floor.

          The size of the feet is 0.02. The feet are spheres.
          solimp parameters are taken from go1. 
          -->
          <geom type="sphere" size="0.021"  pos="0 -0.005 -0.15" solimp="0.9 .95 0.023" contype="0" conaffinity="1"/>
        </default>
    </default>

    <option gravity="0 0 -9.81" timestep="0.004">
        <flag eulerdamp="disable"/>
    </option>
    
    <asset>
        <mesh name="thigh_mesh" file="thigh.stl" scale="0.001 0.001 0.001"/>
        <mesh name="shin_mesh" file="shin.stl" scale="0.001 0.001 0.001"/>

        <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
        
        <texture name="body" type="cube" builtin="flat" mark="cross" width="128" height="128" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" markrgb="1 1 1" random="0.01"/>
        <material name="body" texture="body" texuniform="true" rgba="0.8 0.6 .4 1"/>
        
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4" mark="edge" markrgb=".8 .8 .8"/>
        <material name="grid" texture="grid" texrepeat="5 5" texuniform="true" reflectance="0.2"/>
    </asset>


    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

        <light name="spotlight" mode="targetbodycom" target="torso" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="0 -6 4" cutoff="30"/>
        <geom name="floor" conaffinity="0" contype="1" condim="3" material="grid" pos="0 0 0" size="10 10 10" type="plane"/>

        <body name="torso" pos="0 0 .38">
            <camera name="track" mode="trackcom" pos="0 -2 0.1" xyaxes="1 0 0 0 0 1"/>
            <geom quat="0 0 0.7071068 0.7071068" type="cylinder" name="front_torso_center_geom" size="0.05 0.025" pos="0 0 0"  rgba="0.8 0.5 0.2 1"/>
            <freejoint/>
            <site name="imu" pos="0 0 0" group="5"/>
            <body name="front_torso" pos="0 0 0">
                <joint name="spine_joint" damping="0.1" type="hinge" axis="0 1 0" pos="0 0 0" range="-2 2"/>
                <geom fromto="0 0 0 .195586 0 0" rgba="0.141 0.141 0.141 1" name="front_torso_geom" size="0.01" type="capsule"/>
                <geom quat="0 0 0.7071068 0.7071068" rgba="0.141 0.141 0.141 1" type="cylinder" size="0.046 0.01" pos="0.119488 0.001 0" friction="1.0 .1 .1"/>

                <body name="fthigh" pos=".195586 0 0">
                    <joint axis="0 1 0" damping="0.1" name="fthigh_joint" pos="0 0 0" range="-3 3" type="hinge"/>
                    <geom quat="0 0 0.7071068 0.7071068" rgba="0.329 0.329 0.329 1" name="fthigh_pully_geom" type="cylinder" size="0.0585 0.01" pos="0.01 0 0"/>
                    <geom quat="0 0 0.7071068 0.7071068" rgba="0.329 0.329 0.329 1" name="fthigh_geom" pos="0.01 -0.02 0" type="mesh" mesh="thigh_mesh" friction="1.0 .1 .1"/> 
                    
                    <body name="fshin" pos="0.01 -0.02 -0.175026">
                        <joint axis="0 1 0" damping="0.1" name="fshin_joint" pos="0 0 0" range="-2.8 2.8" type="hinge"/>
                        <geom quat="0 0 0.7071068 0.7071068" name="fshin_geom" pos="0 0 0.175026" rgba="0.51 0.51 0.51 1" type="mesh" mesh="shin_mesh" friction="2.5 .1 .1"/>
                        <geom name="ffoot" class="foot" rgba="0.8 0.5 0.2 1"/>  <!-- set front foot to yellow to identify front vs back -->
                        <site name="ffoot" pos="0 -0.005 -0.15" group="5"/>
                    </body>

                </body>
            </body>

            <body name="back_torso" pos="0 0 0">
                <geom fromto="-.195586 0 0 0 0 0" rgba="0.141 0.141 0.141 1" name="back_torso_geom" size="0.01" type="capsule"/>
                <geom quat="0 0 0.7071068 0.7071068" rgba="0.141 0.141 0.141 1" type="cylinder" size="0.046 0.01" pos="-0.119488 0.001 0"/>

                <body name="bthigh" pos="-.195586 0 0">
                    <joint axis="0 1 0" damping="0.1" name="bthigh_joint" pos="0 0 0" range="-3 3" type="hinge"/>
                    <geom quat="0 0 0.7071068 0.7071068" rgba="0.329 0.329 0.329 1" name="bthigh_pully_geom" type="cylinder" size="0.0585 0.01" pos="-0.01 0 0" />
                    <geom quat="0 0 0.7071068 0.7071068" rgba="0.329 0.329 0.329 1" name="bthigh_geom" pos="-0.01 -0.02 0" type="mesh" mesh="thigh_mesh" friction="1.0 .1 .1"/> 

                    <body name="bshin" pos="-0.01 -0.02 -0.175026">
                        <joint axis="0 1 0" damping="0.1" name="bshin_joint" pos="0 0 0" range="-2.8 2.8" type="hinge"/>
                        <geom quat="0 0 0.7071068 0.7071068" name="bshin_geom" pos="0 0 0.175026" rgba="0.51 0.51 0.51 1" type="mesh" mesh="shin_mesh" friction="2.5 .1 .1"/>
                        <geom name="bfoot" class="foot"/>
                        <site name="bfoot" pos="0 -0.005 -0.15" group="5"/>
                    </body>

                </body>
            </body>

        </body>
    </worldbody>

    <actuator>
        <position joint="spine_joint" name="spine"/>
        <position joint="bthigh_joint" name="bthigh"/>
        <position joint="bshin_joint" name="bshin"/>
        <position joint="fthigh_joint" name="fthigh"/>
        <position joint="fshin_joint" name="fshin"/>
    </actuator>

    <sensor>
        <gyro site="imu" name="gyro"/>
        <velocimeter site="imu" name="local_linvel"/>
        <accelerometer site="imu" name="accelerometer"/>
        <framepos objtype="site" objname="imu" name="position"/>
        <framezaxis objtype="site" objname="imu" name="upvector"/>
        <framexaxis objtype="site" objname="imu" name="forwardvector"/>
        <framelinvel objtype="site" objname="imu" name="global_linvel"/>
        <frameangvel objtype="site" objname="imu" name="global_angvel"/>
        <framequat objtype="site" objname="imu" name="orientation"/>
        <framelinvel objtype="site" objname="ffoot" name="ffoot_global_linvel"/>
        <framepos objtype="site" objname="ffoot" name="ffoot_pos" reftype="geom" refname="front_torso_center_geom"/>  <!-- check if this refname works -->
        <framelinvel objtype="site" objname="bfoot" name="bfoot_global_linvel"/>
        <framepos objtype="site" objname="bfoot" name="bfoot_pos" reftype="geom" refname="front_torso_center_geom"/>  <!-- check if this refname works -->
    </sensor>

  <keyframe>
    <key name="home" qpos="0 0 0.38 1 0 0 0 0 0.51 -1.37 0.51 -1.37" ctrl="0 0 0 0 0"/>  <!-- resets the model to the home position -->
  </keyframe>

</mujoco>
